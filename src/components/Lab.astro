---
import type { messages } from "../content/messages";
import "../styles/global.css";

type Copy = (typeof messages)[keyof typeof messages];
interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(`${base}${copy.lang}/`, Astro.site);
const alternate = new URL(`${base}${copy.alternate}/`, Astro.site);
const patterns = Object.entries(copy.patterns);
const faults = Object.entries(copy.faults);
---

<!doctype html>
<html lang={copy.lang} data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.intro} />
    <meta name="theme-color" content="#fdf8f8" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={copy.lang} href={canonical} />
    <link rel="alternate" hreflang={copy.alternate} href={alternate} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`${base}en/`, Astro.site)}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono&family=Source+Serif+4:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{copy.title}</title>
    <script is:inline>
      (() => {
        const key = "rcl-theme";
        const saved = localStorage.getItem(key);
        const preference =
          saved === "light" || saved === "dark" ? saved : "system";
        const dark = matchMedia("(prefers-color-scheme: dark)");
        const theme =
          preference === "system"
            ? dark.matches
              ? "dark"
              : "light"
            : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body data-locale={copy.lang}>
    <a class="skip-link" href="#simulator">{copy.skip}</a>
    <header class="site-header">
      <a class="identity" href={`${base}${copy.lang}/`} aria-current="page"
        >{copy.title}</a
      >
      <div class="utilities">
        <details class="disclosure" data-theme-control>
          <summary aria-label={copy.theme}
            ><span class="theme-icon" aria-hidden="true">◐</span><span
              data-theme-current>{copy.system}</span
            ></summary
          >
          <div class="menu theme-menu" role="group" aria-label={copy.theme}>
            {
              [copy.system, copy.light, copy.dark].map((label, index) => (
                <button
                  type="button"
                  data-theme-value={["system", "light", "dark"][index]}
                  aria-pressed="false"
                >
                  {label}
                </button>
              ))
            }
          </div>
        </details>
        <a
          class="locale"
          href={alternate.pathname}
          hreflang={copy.alternate}
          aria-label={`${copy.lang.toUpperCase()} / ${copy.alternate.toUpperCase()}`}
          ><strong>{copy.lang.toUpperCase()}</strong><span
            class="locale-separator"
            aria-hidden="true"
          >
            /
          </span><span>{copy.alternate.toUpperCase()}</span></a
        >
        <a
          class="icon-link"
          href="https://github.com/SebastianGaray/resilient-commerce-lab"
          aria-label={copy.repository}>GitHub ↗</a
        >
        <details class="disclosure nav-menu">
          <summary>{copy.menu}</summary>
          <nav class="menu" aria-label={copy.menu}>
            <a href="#simulator">{copy.controls}</a><a href="#observability"
              >{copy.metrics}</a
            ><a href="#production">{copy.production}</a>
            <a href="https://sebastiangaray.github.io/">{copy.portfolio}</a>
          </nav>
        </details>
      </div>
    </header>
    <main>
      <section class="intro">
        <p class="eyebrow">{copy.disclaimer}</p><h1>{copy.title}</h1><p>
          {copy.intro}
        </p>
      </section>
      <section
        id="simulator"
        class="workspace"
        aria-labelledby="controls-title"
      >
        <form class="controls panel" data-controls>
          <div class="section-heading">
            <p class="eyebrow">01</p><h2 id="controls-title">
              {copy.controls}
            </h2>
          </div>
          <label
            >{copy.traffic}<output data-rate-output>24</output><input
              name="rate"
              type="range"
              min="4"
              max="100"
              value="24"
            /></label
          >
          <label
            >{copy.pattern}<select name="pattern"
              >{
                patterns.map(([value, label]) => (
                  <option value={value}>{label}</option>
                ))
              }</select
            ></label
          >
          <label
            >{copy.seed}<input
              name="seed"
              type="number"
              min="1"
              max="999999"
              value="42"
            /></label
          >
          <label
            >{copy.fault}<select name="fault"
              >{
                faults.map(([value, label]) => (
                  <option value={value}>{label}</option>
                ))
              }</select
            ></label
          >
          <label
            >{copy.intensity}<output data-intensity-output>0%</output><input
              name="intensity"
              type="range"
              min="0"
              max="100"
              value="0"
            /></label
          >
          <fieldset>
            <legend>{copy.resilience}</legend>
            <label class="check"
              ><input name="cache" type="checkbox" checked />{copy.cache}</label
            >
            <label
              >{copy.timeout}<select name="timeout"
                ><option value="300">300 ms</option><option value="650" selected
                  >650 ms</option
                ><option value="1200">1200 ms</option></select
              ></label
            >
            <label
              >{copy.retries}<select name="retries"
                ><option value="0">0</option><option value="1" selected
                  >1</option
                ><option value="2">2</option></select
              ></label
            >
            <label class="check"
              ><input name="jitter" type="checkbox" checked />{
                copy.jitter
              }</label
            >
            <label class="check"
              ><input name="circuit" type="checkbox" checked />{
                copy.circuit
              }</label
            >
            <label
              >{copy.limit}<input
                name="limit"
                type="number"
                min="1"
                max="120"
                value="48"
              /></label
            >
            <label class="check"
              ><input name="idempotency" type="checkbox" checked />{
                copy.idempotency
              }</label
            >
          </fieldset>
          <div class="playback-options">
            <label
              >{copy.playback.speed}<select name="speed"
                ><option value="0.5">0.5×</option><option value="1" selected
                  >1×</option
                ><option value="2">2×</option></select
              ></label
            >
            <label
              >{copy.playback.mode}<select name="mode"
                ><option value="single">{copy.playback.single}</option><option
                  value="continuous">{copy.playback.continuous}</option
                ></select
              ></label
            >
            <small data-loop-note hidden>{copy.playback.loopNote}</small>
          </div>
          <div class="playback-actions">
            <button class="primary" type="submit" data-play
              >{copy.playback.play}</button
            >
            <button class="secondary" type="button" data-pause
              >{copy.playback.pause}</button
            >
            <button class="secondary" type="button" data-restart
              >{copy.playback.restart}</button
            >
          </div>
        </form>
        <div class="main-output">
          <section
            class="panel architecture"
            aria-labelledby="architecture-title"
          >
            <div class="section-heading">
              <p class="eyebrow">02</p><h2 id="architecture-title">
                {copy.architecture}
              </h2>
            </div>
            <div class="playback-status">
              <span>{copy.playback.time}</span><strong data-playback-time
                >0.0 s</strong
              ><progress data-playback-progress max="100" value="0">0%</progress
              >
            </div>
            <svg
              viewBox="0 0 780 360"
              role="img"
              aria-labelledby="diagram-title diagram-desc"
              data-topology
            >
              <title id="diagram-title">{copy.architecture}</title><desc
                id="diagram-desc"
                >Client to gateway and order service, then inventory, payment,
                cache and asynchronous worker.</desc
              >
              <g class="edges"
                ><path data-edge="client-limiter" d="M105 180H135"></path><path
                  data-edge="limiter-gateway"
                  d="M205 180H240"></path><path
                  data-edge="client-gateway"
                  d="M105 180H240"></path><path
                  data-edge="gateway-order"
                  d="M335 180H390"></path><path
                  data-edge="order-cache"
                  d="M445 150V95"></path><path
                  data-edge="order-inventory"
                  d="M500 165C550 165 550 70 610 70"></path><path
                  data-edge="order-payment"
                  d="M500 185H610"></path><path
                  data-edge="order-queue"
                  d="M445 210V290H510"></path><path
                  data-edge="queue-worker"
                  d="M600 290H650"></path></g
              >
              <g class="nodes"
                ><g data-node="client" transform="translate(20 150)"
                  ><rect width="85" height="60"></rect><text x="42" y="36"
                    >Client</text
                  ></g
                ><g data-node="limiter" transform="translate(135 150)"
                  ><rect width="70" height="60"></rect><text x="35" y="27"
                    >Rate</text
                  ><text x="35" y="44">limit</text></g
                ><g data-node="gateway" transform="translate(240 150)"
                  ><rect width="95" height="60"></rect><text x="47" y="27"
                    >API</text
                  ><text x="47" y="44">Gateway</text></g
                ><g data-node="order" transform="translate(390 150)"
                  ><rect width="110" height="60"></rect><text x="55" y="27"
                    >Order</text
                  ><text x="55" y="44">Service</text></g
                ><g data-node="cache" transform="translate(390 35)"
                  ><rect width="110" height="60"></rect><text x="55" y="36"
                    >Cache</text
                  ></g
                ><g data-node="inventory" transform="translate(610 40)"
                  ><rect width="130" height="60"></rect><text x="65" y="27"
                    >Inventory</text
                  ><text x="65" y="44">Service</text></g
                ><g data-node="payment" transform="translate(610 150)"
                  ><rect width="130" height="60"></rect><text x="65" y="27"
                    >Payment</text
                  ><text x="65" y="44">Service</text></g
                ><g data-node="queue" transform="translate(510 260)"
                  ><rect width="90" height="60"></rect><text x="45" y="36"
                    >Queue</text
                  ></g
                ><g data-node="worker" transform="translate(650 260)"
                  ><rect width="90" height="60"></rect><text x="45" y="36"
                    >Worker</text
                  ></g
                ></g
              >
              <g class="orbs" data-orbs aria-hidden="true"></g>
            </svg>
            <div class="topology-annotations" data-annotations></div>
            <div class="flow-legend" aria-label={copy.playback.legend}>
              <strong>{copy.playback.legend}</strong><ul>
                {
                  Object.entries(copy.flowLegend).map(([kind, label]) => (
                    <li>
                      <span class={`legend-orb flow-${kind}`} />
                      {label}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="activity" aria-live="polite">
              <strong>{copy.activity}</strong><ul data-activity></ul>
            </div>
          </section>
          <section class="panel customer" aria-labelledby="customer-title">
            <div>
              <p class="eyebrow">{copy.simulated}</p><h2 id="customer-title">
                {copy.customer}
              </h2>
            </div><div data-customer-state class="customer-card"></div>
          </section>
        </div>
      </section>
      <section id="observability" class="observability">
        <div class="section-heading">
          <p class="eyebrow">03</p><h2>{copy.metrics}</h2>
        </div>
        <div class="metrics" data-metrics></div>
        <div class="two-column">
          <section class="panel">
            <h3>{copy.comparison}</h3><div class="comparison" data-comparison>
            </div>
          </section><section class="panel">
            <h3>{copy.traces}</h3><div data-traces>{copy.traceEmpty}</div>
          </section>
        </div>
      </section>
      <section id="production" class="production">
        <div class="section-heading">
          <p class="eyebrow">04</p><h2>{copy.production}</h2>
        </div><p>{copy.contextIntro}</p>
        <div class="context-grid">
          {
            copy.contexts.map(
              ([name, simulation, production, tradeoff, omitted]) => (
                <details class="panel">
                  <>
                    <summary>{name}</summary>
                    <dl>
                      <>
                        <dt>
                          {copy.lang === "en"
                            ? "In this simulation"
                            : "En esta simulación"}
                        </dt>
                        <dd>{simulation}</dd>
                        <dt>
                          {copy.lang === "en"
                            ? "In a production system"
                            : "En un sistema de producción"}
                        </dt>
                        <dd>{production}</dd>
                        <dt>{copy.lang === "en" ? "Trade-off" : "Costo"}</dt>
                        <dd>{tradeoff}</dd>
                        <dt>
                          {copy.lang === "en"
                            ? "Not modeled here"
                            : "No modelado aquí"}
                        </dt>
                        <dd>{omitted}</dd>
                      </>
                    </dl>
                  </>
                </details>
              ),
            )
          }
        </div>
      </section>
    </main>
    <script>
      import "../scripts/lab";
    </script>
  </body>
</html>
